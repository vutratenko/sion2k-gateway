# Source before generate:  set -a && source generate.env && set +a
# VIP must be inside POOL_CIDR and must not use .113/.114 (legacy per-app Gateways).
# Use the cluster-wide Cilium pool (192.168.88.110/29 + .113-.115), not 208/29 — otherwise VIP is not ARP-reachable on LAN.
SION2K_GATEWAY_POOL_CIDR=192.168.88.114/32
SION2K_GATEWAY_VIP=192.168.88.114
